# Backend
DATABASE_URL=sqlite:///./student_os.db
APP_NAME=Student Life OS

# Frontend (Vite dev server proxies /api → backend)
VITE_API_BASE=/api

# ── AI provider (OpenAI-compatible) ──────────────────────────────────────
# Default points at a local OmniRoute proxy. Any OpenAI-compatible endpoint
# works (OpenAI, Groq, OpenRouter, etc.).
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=omniroute-local
AI_MODEL=oc/deepseek-v4-flash-free
# Comma-separated fallback models tried when the primary fails/404s.
AI_MODELS_FALLBACK=
# Master switch: false → every AI path uses deterministic local fallbacks
# (keeps CI/tests hermetic, never touches the network).
AI_ENABLED=true

# ── Google OAuth (read-only Classroom/Gmail/Calendar sync) ───────────────
# Leave blank to run in "not connected" mode with mock fallbacks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── Role auth (STUDENT-PLANAR G1) ────────────────────────────────────────
# Secret used to sign bearer tokens. CHANGE THIS in any real deployment.
APP_SECRET=student-os-dev-secret
# Secret a user must enter to sign up as a Teacher (leave blank to disable
# teacher signups).
TEACHER_SECRET_KEY=

# ── File uploads (STUDENT-PLANAR G1) ─────────────────────────────────────
# Local directory where uploaded files are stored + served from /uploads.
UPLOAD_DIR=./uploads
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=10

# ── Vector store (Zenith-Study-Planner G1) ───────────────────────────────
# "numpy" (default) or "faiss" (requires the optional faiss-cpu package).
VECTOR_STORE_BACKEND=numpy

# ── Sleep tracker (Zenith-Study-Planner G3) ──────────────────────────────
# Target nightly sleep hours used by bedtime/wake-up recommendations.
DEFAULT_SLEEP_TARGET_HOURS=8

# ── SyllabusAI (G13 Phase 87): summary cost guard ─────────────────────────
# Max non-cached AI summary generations per day (LLM cost guard). The
# deterministic demo fallback (AI_ENABLED=false) is exempt from this cap.
SUMMARY_DAILY_LIMIT=10
