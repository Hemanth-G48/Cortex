{"nodes": [{"id": "project_audit_03_second_brain_integration", "label": "Second Brain Integration Analysis", "file_type": "document", "source_file": "project-audit/03-second-brain-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_audit_03_second_brain_integration_local_folder_scanning", "label": "Local Folder Scanning Connection Mechanism", "file_type": "rationale", "source_file": "project-audit/03-second-brain-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Second Brain connects via local folder scanning (KB_WATCH_ENABLED, 30s poll interval) over source folder paths like an Obsidian vault, not a cloud API; a deliberate local-first integration choice."}, {"id": "project_audit_03_second_brain_integration_dual_data_source_problem", "label": "Dual Data Source Problem (DB notes vs KB documents)", "file_type": "concept", "source_file": "project-audit/03-second-brain-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two disconnected note systems: traditional notes (DB notes table, Notes.tsx) and KB documents (KB pipeline, KnowledgeBase/VaultSearch/CourseDetail). A note created in Notes.tsx never appears in KB search and vice versa; DB notes are invisible to search, and Journal/Tasks/Habits/Grades are not synced into the vault either."}, {"id": "project_audit_03_second_brain_integration_course_derivation_tags", "label": "Course Derivation from course:* Tags", "file_type": "concept", "source_file": "project-audit/03-second-brain-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vault documents tagged course:* are automatically synced into course records, deriving subjects from Second Brain content."}, {"id": "project_audit_03_second_brain_integration_auto_subject_detection", "label": "Auto-Subject Detection from Vault Folders", "file_type": "concept", "source_file": "project-audit/03-second-brain-integration.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subject folders in the vault are auto-detected and surfaced as subjects/domains without manual configuration."}], "edges": [{"source": "project_audit_03_second_brain_integration", "target": "project_audit_05_workflow_defects_01_25", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "project-audit/03-second-brain-integration.md", "source_location": null, "weight": 1.0}, {"source": "project_audit_03_second_brain_integration", "target": "project_audit_08_workflow_defects_76_99", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "project-audit/03-second-brain-integration.md", "source_location": null, "weight": 1.0}, {"source": "project_audit_03_second_brain_integration", "target": "project_audit_03_second_brain_integration_local_folder_scanning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-audit/03-second-brain-integration.md", "source_location": null, "weight": 1.0}, {"source": "project_audit_03_second_brain_integration", "target": "project_audit_03_second_brain_integration_dual_data_source_problem", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-audit/03-second-brain-integration.md", "source_location": null, "weight": 1.0}, {"source": "project_audit_03_second_brain_integration", "target": "project_audit_03_second_brain_integration_course_derivation_tags", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-audit/03-second-brain-integration.md", "source_location": null, "weight": 1.0}, {"source": "project_audit_03_second_brain_inte