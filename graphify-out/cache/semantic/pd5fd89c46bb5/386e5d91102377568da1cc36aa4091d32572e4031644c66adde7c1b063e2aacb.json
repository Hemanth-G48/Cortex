{"nodes": [{"id": "project_audit_01_architecture_analysis", "label": "Architecture Analysis", "file_type": "document", "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project_audit_01_architecture_analysis_profile_context_sole_shared_state", "label": "ProfileContext as Sole Shared State", "file_type": "rationale", "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No global state library by design; all state lives in component-level useState and ProfileContext is the only shared context (user profile, theme). Data fetching is per-component via useEffect with no request deduplication and no caching layer."}, {"id": "project_audit_01_architecture_analysis_typed_endpoints_object", "label": "Typed Endpoints Object (api layer)", "file_type": "concept", "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "api.ts (4500+ lines) exposes a generic request() wrapper, api get/post/put/patch/del methods, 100+ type interfaces, and an endpoints object organized by feature module (courses, tasks, kb, ai, vault, fitness, rpg, search)."}, {"id": "project_audit_01_architecture_analysis_silent_error_swallowing", "label": "Silent Error Swallowing (.catch(() => {}))", "file_type": "rationale", "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".catch(() => {}) is used throughout the frontend, silently swallowing API errors so users see empty pages with no indication of failure."}, {"id": "project_audit_01_architecture_analysis_second_brain_pipeline", "label": "Second Brain KB Pipeline (scan, chunk, embed, index, search)", "file_type": "concept", "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pipeline: KB watcher polls every 30s, scanner finds new/changed files, parser converts markdown to structure, chunker makes 1200-char chunks with 150 overlap, embedder produces 384-dim fastembed ONNX vectors, then FTS5 index, vector store, knowledge graph, concepts, auto-subject detection, and auto-course sync from course:* tags."}, {"id": "project_audit_01_architecture_analysis_ai_provider_registry", "label": "AI Provider Registry with Fallback Chain", "file_type": "concept", "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registry in app/data/ai_providers.json supports multiple providers (Ollama, OpenAI, etc.), an AI_MODELS_FALLBACK chain, per-feature budgets (summary_daily_limit, embeddings_daily_limit), a cache layer (600s TTL), and deterministic fallbacks when offline."}, {"id": "project_audit_01_architecture_analysis_column_migration_sprawl", "label": "Column Migration Sprawl (30+ ALTER TABLE)", "file_type": "rationale", "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "30+ ALTER TABLE statements accumulated in database.py instead of a proper migration system, keeping the 40+ table schema current by patching columns at startup."}, {"id": "project_audit_01_architecture_analysis_kb_router_explosion", "label": "KB Router Explosion (50+ routers)", "file_type": "rationale", "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "50+ individual FastAPI routers exist for KB features (kb_sources, kb_documents, kb_search, kb_graph, kb_tutor, etc.) on top of 100+ service modules in services/kb/."}, {"id": "project_audit_01_architecture_analysis_no_request_cancellation", "label": "No Request Cancellation on Navigation", "file_type": "rationale", "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fast navigation can cause race conditions because in-flight fetches are never aborted; responses may update unmounted components."}], "edges": [{"source": "project_audit_01_architecture_analysis", "target": "project_audit_01_architecture_analysis_profile_context_sole_shared_state", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "weight": 1.0}, {"source": "project_audit_01_architecture_analysis", "target": "project_audit_01_architecture_analysis_typed_endpoints_object", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "weight": 1.0}, {"source": "project_audit_01_architecture_analysis", "target": "project_audit_01_architecture_analysis_silent_error_swallowing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "weight": 1.0}, {"source": "project_audit_01_architecture_analysis", "target": "project_audit_01_architecture_analysis_second_brain_pipeline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "project-audit/01-architecture-analysis.md", "source_location": null, "weight": 1.0}, {"source": "project_audit_01_architecture_analysis", "target": "project_audit_01_architecture_analysis_ai_provider_registry", "relation": "references", "confidence": "